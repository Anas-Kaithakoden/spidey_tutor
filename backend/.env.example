#Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (OpenAI-compatible) — production models, long context, JSON mode
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

# OpenRouter (OpenAI-compatible aggregator) — free models supported
# OPENROUTER_MODEL lets you replace the default "openrouter/free" auto-route.
# OPENROUTER_FREE_MODELS: comma-separated free model IDs to expose in the UI
# (free models come and go, keep these configurable rather than hard-coded).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_MODELS=

DATABASE_URL=sqlite:///./spidey.db
CORS_ORIGINS=*